# Copy to scripts/testflight.env (gitignored) and fill in.
# From App Store Connect → Users and Access → Integrations → App Store Connect API:
#   ASC_KEY_ID    = the key's ID (10 chars, shown in the key list)
#   ASC_ISSUER_ID = the Issuer ID (UUID, shown at the top of the page)
# The downloaded AuthKey_<KEYID>.p8 file goes in ~/.appstoreconnect/private_keys/
ASC_KEY_ID=
ASC_ISSUER_ID=
