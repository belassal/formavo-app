rules_version = '2';

// Formavo Storage rules.
// Paths in use (src/services/storageService.ts):
//   users/{uid}/avatar.jpg                         — own profile photo
//   teams/{teamId}/players/{playerId}/avatar.jpg   — player photo (team staff)
//   clubs/{clubId}/players/{playerId}/avatar.jpg   — player photo (club staff)
//   players/{playerId}/avatar.jpg                  — LEGACY player photos, read-only
//   teams/{teamId}/photos/{file}                   — team photo gallery (coach upload/delete)
//   clubs/{clubId}/logo.jpg, sponsor.jpg           — club logo/sponsor (managers)

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }

    function isImage() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isTeamStaff(teamId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role in ['coach', 'assistant'];
    }

    function isClubManager(clubId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/clubs/$(clubId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role in ['owner', 'head_coach'];
    }

    function isClubStaff(clubId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/clubs/$(clubId)/members/$(request.auth.uid));
    }

    match /users/{uid}/{file} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid && isImage();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // LEGACY player avatars (pre-Sep 2026): path carries no team/club id, so
    // membership can't be verified. Frozen read-only — new uploads go to the
    // scoped paths below; existing avatar URLs keep working.
    match /players/{playerId}/{file} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Player avatars, team-scoped (TeamDetail add/edit player)
    match /teams/{teamId}/players/{playerId}/{file} {
      allow read: if isSignedIn();
      allow create, update: if isTeamStaff(teamId) && isImage();
      allow delete: if isTeamStaff(teamId);
    }

    // Player avatars, club-registry-scoped (PlayerEditScreen) — any club staff
    // role may write (all club roles are staff: owner/head_coach/asst_coach/staff)
    match /clubs/{clubId}/players/{playerId}/{file} {
      allow read: if isSignedIn();
      allow create, update: if isClubStaff(clubId) && isImage();
      allow delete: if isClubStaff(clubId);
    }

    match /teams/{teamId}/photos/{file} {
      allow read: if isSignedIn();
      allow create, update: if isTeamStaff(teamId) && isImage();
      allow delete: if isTeamStaff(teamId);
    }

    match /clubs/{clubId}/{file} {
      allow read: if isSignedIn();
      allow create, update: if isClubManager(clubId) && isImage();
      allow delete: if isClubManager(clubId);
    }
  }
}
